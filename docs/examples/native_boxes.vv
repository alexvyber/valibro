import valibro as v
import valibro.types

first := types.symbol('request')
second := types.symbol('request')
assert first != second
assert v.is_valid(v.symbol(), first)
blob := types.Blob{data: [u8(1), 2, 3], mime_type: 'application/octet-stream'}
file := types.File{data: [u8(1)], name: 'sample.bin', mime_type: 'application/octet-stream'}
assert blob.count() == 3
assert file.count() == 1
assert v.safe_parse(v.pipe(v.blob(), v.mime_type[types.Blob](['application/octet-stream'])), blob).success
set := types.new_set_with(['A', 'a'], fn (a string, b string) bool { return a.to_lower() == b.to_lower() })
assert set.count() == 1
assert v.parse(v.set_with(v.string(), fn (a string, b string) bool { return a.to_lower() == b.to_lower() }), set)!.count() == 1
boxed := types.value_of[int](42)
assert types.value_is[int](boxed)
assert types.value_as[int](boxed)! == 42
mut entries := []types.RawEntry{}
types.raw_entry_set(mut entries, types.value_of('a'), types.value_of(1))
types.raw_entry_set(mut entries, types.value_of('a'), types.value_of(2))
assert entries.len == 1
assert types.value_as[int](entries[0].value)! == 2
raw := types.raw_set([types.value_of(1), types.value_of(1)])
assert raw.items.len == 1
ordered := types.entry_map([types.MapEntry[string, int]{key: 'a', value: 1}], fn (a string, b string) bool { return a == b })
assert ordered.count() == 1
