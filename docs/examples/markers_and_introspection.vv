import valibro as v
import valibro.types

struct AccountId {}

fn main() {
    branded := v.pipe_to(v.string(), v.brand[AccountId]())
    flavored := v.pipe_to(v.string(), v.flavor[AccountId]())
    assert v.parse(branded, 'a-1')!.value == 'a-1'
    assert v.parse(flavored, 'a-1')!.value == 'a-1'
    numeric := v.pipe_to(v.number_of[int](), v.flavor_for[int, AccountId]())
    assert v.parse(numeric, 42)!.value == 42
    action := v.min_length(2)
    assert v.action_is_of_kind(action, .validation)
    assert v.action_is_of_type(action, 'min_length')
    assert v.schema_is_of_type(v.string(), 'string')
    assert v.is_of_kind(action, 'validation')
    assert v.is_of_type(action, 'min_length')
    assert v.parse(v.pipe(v.string(), v.readonly()), 'same')! == 'same'
    assert v.parse(v.pipe(v.number_of[int](), v.readonly_for[int]()), 42)! == 42
    identity := v.pipe(v.string(), v.to_string())
    assert v.parse(identity, 'same')! == 'same'
    callback := types.identified_message(fn (issue types.Issue) string { return issue.code })
    assert types.resolve_message(callback, types.Issue{code: 'custom'}) == 'custom'
}
