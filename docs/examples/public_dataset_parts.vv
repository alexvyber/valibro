import valibro as v
import valibro.types

struct Record { name string }
struct Id {}

fn apply_message(callback types.MessageFunction, issue types.Issue) string { return callback(issue) }

fn main() {
    annotations := types.Annotations{title: 'Count'}
    examples := types.Examples[int]{present: true, values: [1, 2]}
    action := types.Action[int]{kind: .validation, annotations: annotations, native_examples: examples, run: fn (input int) types.Dataset[int] {
        return types.Dataset[int]{value: input}
    }}
    assert v.safe_parse(v.pipe(v.number_of[int](), action), 1).success
    transformation := types.Transformation[int, string]{type_name: 'display', run: fn (input int) types.Dataset[string] {
        return types.Dataset[string]{value: input.str()}
    }}
    assert v.parse(v.pipe_to(v.number_of[int](), transformation), 42)! == '42'
    runner := types.PipelineRunner[int, int]{available: true, run: fn (dataset types.Dataset[int], config types.Config) types.Dataset[int] { return dataset }}
    assert runner.run(types.Dataset[int]{value: 42}, types.Config{}).value == 42
    default := types.DefaultProvider[int]{available: true, get: fn (config types.Config) int { return 42 }}
    context := types.DefaultContextProvider[int]{available: true, get: fn (dataset ?types.Dataset[int], config types.Config) int { return 42 }}
    fallback := types.FallbackProvider[int]{available: true, get: fn (dataset ?types.Dataset[int], config types.Config) int { return 42 }}
    assert default.get(types.Config{}) == 42
    assert context.get(none, types.Config{}) == 42
    assert fallback.get(none, types.Config{}) == 42
    message := types.DefaultMessage{text: 'Invalid'}
    provider := types.MessageProvider{active: true, get: fn (issue types.Issue) string { return issue.code }}
    settings := types.Messages{global: {'en': types.ErrorMessage('Invalid')}}
    _ = message
    _ = provider
    _ = settings
    raw := types.RawArray{items: [types.value_of(42)]}
    set := types.RawSet{items: raw.items}
    entry := types.RawEntry{key: types.value_of('name'), value: types.value_of('Alex')}
    raw_map := types.RawMap{entries: [entry]}
    object := types.RawObject{entries: [entry]}
    partial := types.RawStruct[Record]{value: Record{name: 'Alex'}, keys: ['name'], fields: {'name': types.value_of('Alex')}}
    assert set.items.len == 1 && raw_map.entries.len == 1 && object.entries.len == 1
    assert partial.value.name == 'Alex'
    branded := types.Branded[int, Id]{value: 42}
    flavored := types.Flavored[int, Id]{value: 42}
    assert branded.value == flavored.value
    callback := fn (issue types.Issue) string { return issue.code }
    assert apply_message(callback, types.Issue{code: 'example'}) == 'example'
}
