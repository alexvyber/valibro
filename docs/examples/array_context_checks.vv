import valibro as v

base := v.array(v.number_of[int]())
every := v.pipe(base, v.every_item_with_array(fn (value int, index int, original []int) bool {
    return value == original[index]
}))
assert v.safe_parse(every, [1, 2]).success
some := v.pipe(base, v.some_item_with_array(fn (value int, index int, original []int) bool {
    return index == original.len - 1
}))
assert v.safe_parse(some, [1, 2]).success
checks := v.pipe(base, v.check_items_with_array(fn (value int, index int, original []int) bool {
    return value > original[0]
}))
result := v.safe_parse(checks, [1, 2, 0])
assert result.issues.len == 2
assert v.get_dot_path(result.issues[1]) == '2'
