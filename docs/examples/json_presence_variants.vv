import valibro.json as j
import valibro.types
import x.json2

getter := fn (config types.Config) json2.Any { return json2.Any('guest') }
fields := j.object({
    'a': j.exact_optional(j.string(), 'guest')
    'b': j.optional_with_default(j.string(), getter)
    'c': j.exact_optional_with_default(j.string(), getter)
    'd': j.nullish_with_default(j.string(), getter)
})
assert j.parse(fields, json2.Any(map[string]json2.Any{}))!.as_map().len == 4
assert j.parse(j.nullable(j.string()), json2.Null{})! is json2.Null
assert j.parse(j.nullish(j.string()), json2.Null{})! is json2.Null
assert j.parse(j.nullable_with_default(j.string(), getter), json2.Null{})!.str() == 'guest'
assert !j.is_valid(j.non_nullable(j.nullable(j.string())), json2.Null{})
assert !j.is_valid(j.non_nullish(j.nullish(j.string())), json2.Null{})
required := j.object({'a': j.non_optional(j.optional(j.string()))})
assert !j.is_valid(required, json2.Any(map[string]json2.Any{}))
