import valibro.json as j
import valibro.jsoncodec
import valibro.types
import x.json2

struct Named { name string }
pub fn (value Named) to_json_value(key string) !types.Maybe[json2.Any] {
    return types.some[json2.Any](value.name)
}
fn project(value jsoncodec.JsonValueProvider) !types.Maybe[json2.Any] { return value.to_json_value('') }

fn make_reviver() jsoncodec.Reviver {
    return fn (key string, value json2.Any, context jsoncodec.ReviverContext) !types.Maybe[json2.Any] { return types.some(value) }
}
fn make_replacer() jsoncodec.Replacer {
    return fn (key string, value json2.Any) !types.Maybe[json2.Any] { return types.some(value) }
}
fn make_contextual() jsoncodec.ContextReplacer {
    return fn (key string, value json2.Any, context jsoncodec.ReplacerContext) !types.Maybe[json2.Any] { return types.some(value) }
}
fn make_presence() jsoncodec.PresenceReplacer {
    return fn (key string, value types.Maybe[json2.Any], context jsoncodec.ReplacerContext) !types.Maybe[json2.Any] { return value }
}
fn make_hook() jsoncodec.JsonSourceHook {
    return fn (key string) !types.Maybe[json2.Any] { return types.some[json2.Any]('hook') }
}
fn build_shape(rebuild j.ShapeRebuilder) j.Schema {
    return rebuild({'name': j.string()})
}

fn main() {
    assert project(Named{name: 'Alex'})!.value.str() == 'Alex'
    reviver := make_reviver()
    replacer := make_replacer()
    contextual := make_contextual()
    presence := make_presence()
    indent := jsoncodec.Indent(2)
    parsed := jsoncodec.parse('{"name":"Alex"}', jsoncodec.ParseConfig{reviver: reviver})!
    output := jsoncodec.stringify(parsed.value, jsoncodec.StringifyConfig{replacer: replacer, replacer_with_context: contextual, replacer_with_presence: presence, space: indent})!
    assert output.contains('Alex')
    assert jsoncodec.stringify_source(jsoncodec.JsonSource{hook: make_hook()}, jsoncodec.StringifyConfig{})! == '"hook"'
    rebuild := fn (entries map[string]j.Schema) j.Schema { return j.strict_object(entries) }
    assert j.parse_text(build_shape(rebuild), '{"name":"Alex"}')!.as_map().len == 1
}
