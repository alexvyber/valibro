import valibro as v
import valibro.json as j
import x.json2

age_entries := {'age': j.number()}
fields := j.entries_from_objects(j.entries_from_list(['name'], j.string()), age_entries)
base := j.object(fields)
assert j.parse_text(j.omit(base, ['age']), '{"name":"Alex","age":42}')!.as_map().len == 1
assert j.safe_parse(j.keyof(base), 'name').success
required := j.required(j.partial(base))
assert !j.safe_parse(required, map[string]json2.Any{}).success
assert !j.safe_parse(j.required_with_message(j.partial(base), 'Required'), map[string]json2.Any{}).success
values := json2.Any([json2.Any('a'), json2.Any(1), json2.Any(true)])
assert j.parse(j.tuple([j.string(), j.number()]), values)!.as_array().len == 2
assert j.parse(j.loose_tuple([j.string(), j.number()]), values)!.as_array().len == 3
assert !j.safe_parse(j.strict_tuple([j.string(), j.number()]), values).success
assert j.safe_parse(j.tuple_with_rest([j.string()], j.number()), json2.Any([json2.Any('a'), json2.Any(1)])).success
loose := j.loose_object({'name': j.string()})
assert j.parse_text(loose, '{"name":"Alex","extra":true}')!.as_map().len == 2
rest := j.object_with_rest({'name': j.string()}, j.boolean())
assert !j.safe_parse(rest, json2.Any({'name': json2.Any('Alex'), 'extra': json2.Any(1)})).success
intersection := j.intersect([j.object({'name': j.string()}), j.object({'age': j.number()})])
assert j.parse_text(intersection, '{"name":"Alex","age":42}')!.as_map().len == 2
native := j.native(j.string())
assert v.parse(native, json2.Any('Alex'))!.str() == 'Alex'
