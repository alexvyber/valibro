import valibro as v
import valibro.types
import math.big
import time

struct Stored {
    amount i64
}

pub fn (value Stored) to_number() !f64 { return f64(value.amount) }
pub fn (value Stored) to_bigint() !big.Integer { return big.integer_from_i64(value.amount) }
pub fn (value Stored) to_boolean() !bool { return value.amount != 0 }
pub fn (value Stored) to_date() !time.Time { return time.unix_milli(value.amount) }
pub fn (value Stored) to_string() !string { return value.amount.str() }
pub fn (value Stored) count() int { return int(value.amount) }

fn number(value types.NumberProvider) !f64 { return value.to_number() }
fn integer(value types.BigintProvider) !big.Integer { return value.to_bigint() }
fn boolean(value types.BooleanProvider) !bool { return value.to_boolean() }
fn date(value types.DateProvider) !time.Time { return value.to_date() }
fn text(value types.StringProvider) !string { return value.to_string() }
fn count(value types.Countable) int { return value.count() }
fn presence(value types.NativeMaybe) types.Presence { return value.maybe_state() }
fn callable(value types.FunctionValue) bool { return value.function_value() }

fn main() {
    input := Stored{amount: 42}
    assert number(input)! == 42.0
    assert integer(input)!.str() == '42'
    assert boolean(input)!
    assert date(input)!.unix_milli() == 42
    assert text(input)! == '42'
    assert count(input) == 42
    assert presence(types.some(42)) == .value
    assert callable(types.Function[int, int]{call: fn (n int) int { return n }})
    base := v.unknown[Stored]()
    assert v.parse(v.pipe_to(base, v.to_number_from[Stored]()), input)! == 42.0
    assert v.parse(v.pipe_to(base, v.to_bigint_from[Stored]()), input)!.str() == '42'
    assert v.parse(v.pipe_to(base, v.to_boolean_from[Stored]()), input)!
    assert v.parse(v.pipe_to(base, v.to_date_from[Stored]()), input)!.unix_milli() == 42
    assert v.parse(v.pipe_to(base, v.to_string_from[Stored]()), input)! == '42'
}
