import valibro as v
import valibro.types

base := v.pipe(v.string(), v.trim())
schema := v.optional_with_default_context(base, fn (dataset ?types.Dataset[types.Maybe[string]], config v.Config) string {
    if input := dataset { assert input.value.state == .missing }
    return ' guest '
})
assert v.get_default_with_context(schema, none)?.value == ' guest '
assert v.parse(schema, types.missing[string]())!.value == 'guest'
stateful := v.exact_optional_with_default_state(base, fn (dataset ?types.Dataset[types.Maybe[string]], config v.Config) types.Maybe[string] {
    return types.undefined_value[string]()
})
assert v.get_default(stateful)?.state == .undefined
assert !v.safe_parse(stateful, types.missing[string]()).success
fallback := v.fallback_fn(v.pipe(base, v.min_length(3)), fn (input string, issues []types.Issue) string {
    assert issues.len > 0
    return 'fallback for ' + input
})
assert v.parse(fallback, 'x')! == 'fallback for x'
assert v.get_fallback(fallback) == none
contextual := v.fallback_with_context(v.pipe(base, v.min_length(3)), fn (dataset ?types.Dataset[string], config v.Config) string {
    if result := dataset { return 'issues: ' + result.issues.len.str() }
    return 'inspection'
})
assert v.get_fallback_with_context(contextual, none)? == 'inspection'
assert v.parse(contextual, 'x')! == 'issues: 1'
wrapped := v.optional(v.string())
inner := v.unwrap_as[types.Maybe[string], types.Maybe[string], string, string](wrapped)!
assert v.parse(inner, 'hello')! == 'hello'
